%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 600 360
%%HiResBoundingBox: 0 0 600 360
%%Title: EPS preview example
%%EndComments
0.10 0.18 0.30 setrgbcolor
0 0 600 360 rectfill
0.45 0.65 0.95 setrgbcolor
2 setlinewidth
60 70 moveto 540 70 lineto stroke
60 70 moveto 60 300 lineto stroke
0.5 0.9 0.8 setrgbcolor
4 setlinewidth
60 110 moveto 140 130 lineto 220 200 lineto 300 180 lineto 380 260 lineto 460 240 lineto 540 290 lineto stroke
0.9 0.95 1 setrgbcolor
/Helvetica findfont 22 scalefont setfont
60 325 moveto (EPS / GHOSTSCRIPT) show
/Helvetica findfont 12 scalefont setfont
60 35 moveto (Zoom, pan and browse with the same controls.) show
showpage
%%EOF
